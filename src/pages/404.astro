---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const totalPosts = allPosts.length;

const popularCategories = [
  { name: 'Python', url: '/categories/python/' },
  { name: 'Java', url: '/categories/java/' },
  { name: 'NetworkX & Graph', url: '/tags/networkx/' },
  { name: 'Algorithm', url: '/categories/algorithm/' },
  { name: 'Dev Tools & Vim', url: '/tags/vim/' },
  { name: 'Database', url: '/tags/database/' },
];
---

<BaseLayout title="404 : 페이지를 찾을 수 없습니다">
  <div class="py-16 sm:py-24 max-w-2xl mx-auto text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-rose-500/20 bg-rose-500/10 text-rose-600 dark:text-rose-400 text-xs font-mono font-medium mb-6">
      <span>HTTP 404 · PAGE NOT FOUND</span>
    </div>

    <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50 mb-4">
      페이지를 찾을 수 없습니다
    </h1>

    <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 leading-relaxed mb-8">
      요청하신 문서의 경로가 변경되었거나 삭제되었을 수 있습니다.<br />
      아래 검색창을 통해 원하는 주제를 검색하거나 주요 카테고리를 탐색해 보세요.
    </p>

    <!-- Search Form -->
    <form action="/search/" method="get" class="max-w-md mx-auto mb-10">
      <div class="relative flex items-center">
        <input
          type="text"
          name="q"
          placeholder="검색어를 입력하세요 (예: networkx, python, java)..."
          class="w-full px-4 py-3 pl-11 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 text-sm focus:outline-hidden focus:ring-2 focus:ring-blue-500/50 focus:border-blue-500 shadow-sm"
        />
        <svg
          class="w-5 h-5 text-zinc-400 absolute left-3.5 pointer-events-none"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <button
          type="submit"
          class="absolute right-2 px-3.5 py-1.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold shadow-xs transition-colors cursor-pointer"
        >
          검색
        </button>
      </div>
    </form>

    <!-- Action Buttons -->
    <div class="flex flex-wrap items-center justify-center gap-3 mb-12">
      <a
        href="/"
        class="px-5 py-2.5 rounded-xl bg-zinc-900 dark:bg-zinc-100 hover:bg-zinc-800 dark:hover:bg-white text-white dark:text-zinc-950 font-semibold text-xs shadow-sm transition-colors"
      >
        홈으로 돌아가기
      </a>
      <a
        href="/about/"
        class="px-5 py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 hover:border-zinc-300 dark:hover:border-zinc-700 text-zinc-800 dark:text-zinc-200 font-semibold text-xs shadow-xs transition-colors"
      >
        포트폴리오 & 이력
      </a>
    </div>

    <!-- Quick Links -->
    <div class="pt-8 border-t border-zinc-200/80 dark:border-zinc-800/80">
      <span class="text-xs text-zinc-400 font-medium block mb-3">인기 카테고리 & 기술 스택:</span>
      <div class="flex flex-wrap items-center justify-center gap-2">
        {popularCategories.map((item) => (
          <a
            href={item.url}
            class="text-xs px-3 py-1.5 rounded-lg border border-zinc-200/80 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/50 text-zinc-600 dark:text-zinc-400 hover:border-blue-500 hover:text-blue-600 dark:hover:border-blue-400 dark:hover:text-blue-400 transition-colors"
          >
            {item.name}
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
