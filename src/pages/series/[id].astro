---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { cleanExcerpt, getReadingTime } from '../../utils/excerpt';

import { cleanTitle } from '../../utils/seoTitle';

export async function getStaticPaths() {
  function getPostUrl(post: any) {
    if (post.data.permalink) {
      const clean = post.data.permalink.replace(/^\/+|\/+$/g, '');
      return `/${clean}/`;
    }
    const filename = post.id.replace(/\.md$/, '');
    const slugMatch = filename.match(/^(\d{4}-\d{2}-\d{2})-(.*)$/);
    const postSlug = slugMatch ? slugMatch[2] : filename;
    const cat = (post.data.category || 'others').toLowerCase().replace(/\s+/g, '-');
    return `/${cat}/${postSlug}/`;
  }

  const allPosts = await getCollection('posts');

  const tracksConfig = [
    {
      id: 'networkx',
      title: 'NetworkX & 그래프 데이터 사이언스',
      subtitle: 'Graph Data Science & Complex Network Analysis',
      icon: '🕸',
      level: '기초 ~ 고급',
      description:
        '국내에서 찾아보기 힘든 수준의 NetworkX 심층 튜토리얼입니다. 노드/엣지 속성 제어부터 이분 그래프, 중심성(Centrality) 분석, 커뮤니티 구조 분석, 고품질 시각화까지 전 과정을 다룹니다.',
      match: (p: any) => {
        const cat = (p.data.category || '').toLowerCase();
        const tags = new Set((p.data.tags || []).map((t: string) => t.toLowerCase().trim()));
        return tags.has('networkx') || tags.has('centrality') || tags.has('bipartite');
      },
    },
    {
      id: 'python',
      title: 'Python Deep-Dive & 내부 메커니즘',
      subtitle: 'Python Core Architecture & Performance',
      icon: '🐍',
      level: '중급 ~ 고급',
      description:
        '단순 문법 학습을 넘어 파이썬 런타임의 동작 원리와 고급 테크닉을 다룹니다. 이터레이터/제너레이터 프로토콜, 데코레이터, GIL과 동시성 모델, NumPy 벡터 연산 최적화를 학습합니다.',
      match: (p: any) => {
        const cat = (p.data.category || '').toLowerCase();
        const tags = new Set((p.data.tags || []).map((t: string) => t.toLowerCase().trim()));
        return cat === 'python' || tags.has('python');
      },
    },
    {
      id: 'algorithm',
      title: '자료구조 & 코딩 테스트 문제 해결 패턴',
      subtitle: 'Data Structures & Problem Solving Patterns',
      icon: '⚡',
      level: '기초 ~ 중급',
      description:
        '실전 문제 해결력을 기르기 위한 자료구조 구현과 알고리즘 핵심 패턴 정리입니다. 트리, 그래프, 동적 계획법(DP), 백트래킹의 대표 문제와 해결 전략을 체계적으로 다룹니다.',
      match: (p: any) => {
        const cat = (p.data.category || '').toLowerCase();
        const tags = new Set((p.data.tags || []).map((t: string) => t.toLowerCase().trim()));
        return cat === 'algorithm' || tags.has('algorithm') || tags.has('tree') || tags.has('linkedlist') || tags.has('dp');
      },
    },
    {
      id: 'java',
      title: 'Java & 엔터프라이즈 객체지향 아키텍처',
      subtitle: 'Java OOP, JVM & Database Engineering',
      icon: '☕',
      level: '기초 ~ 중급',
      description:
        '객체지향 설계 원칙(SOLID), JVM 런타임 메모리 모델, 실전 디자인 패턴, 그리고 SQL/데이터베이스 인터랙션을 학습하여 견고하고 확장 가능한 소프트웨어를 작성하는 방법을 다룹니다.',
      match: (p: any) => {
        const cat = (p.data.category || '').toLowerCase();
        const tags = new Set((p.data.tags || []).map((t: string) => t.toLowerCase().trim()));
        return cat === 'java' || tags.has('java');
      },
    },
  ];

  return tracksConfig.map((track) => {
    // Sort chronologically (oldest to newest: step 1 -> step N)
    const matchingPosts = allPosts
      .filter(track.match)
      .sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime());

    const curriculum = matchingPosts.map((p, idx) => ({
      index: idx + 1,
      title: cleanTitle(p.data.title),
      url: getPostUrl(p),
      date: p.data.date ? new Date(p.data.date).toISOString().split('T')[0] : '',
      readingTime: getReadingTime(p.body),
      excerpt: cleanExcerpt(p.body, 140),
      tags: (p.data.tags || []).slice(0, 4),
    }));

    return {
      params: { id: track.id },
      props: { track, curriculum },
    };
  });
}

const { track, curriculum } = Astro.props;
const totalCount = curriculum.length;

const breadcrumbs = [
  { name: '홈', url: '/' },
  { name: 'Series', url: '/series/' },
  { name: track.title, url: `/series/${track.id}/` },
];
---

<BaseLayout
  title={`${track.title} 커리큘럼`}
  description={track.description}
  breadcrumbs={breadcrumbs}
>
  <div class="space-y-8">
    <!-- Breadcrumb Nav -->
    <nav class="flex items-center space-x-2 text-xs text-zinc-400 mb-2">
      <a href="/" class="hover:underline">Home</a>
      <span>&gt;</span>
      <a href="/series/" class="hover:underline">Series</a>
      <span>&gt;</span>
      <span class="text-zinc-600 dark:text-zinc-300 font-medium">{track.title}</span>
    </nav>

    <!-- Track Hero Header -->
    <header class="p-6 sm:p-8 rounded-3xl border border-blue-500/20 bg-gradient-to-br from-blue-50/50 via-indigo-50/20 to-transparent dark:from-blue-950/30 dark:via-indigo-950/10 dark:to-transparent shadow-xs">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-start gap-4">
          <span class="text-3xl sm:text-4xl p-3 rounded-2xl bg-blue-500/10 text-blue-600 dark:text-blue-400 shrink-0">
            {track.icon}
          </span>
          <div>
            <div class="flex flex-wrap items-center gap-2 mb-1.5">
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20 font-mono">
                {track.level}
              </span>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 font-mono">
                총 {totalCount}개 아티클 수록
              </span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 dark:text-zinc-50 tracking-tight">
              {track.title}
            </h1>
            <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 font-mono mt-0.5">
              {track.subtitle}
            </p>
          </div>
        </div>
      </div>
      <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mt-4 leading-relaxed pt-4 border-t border-zinc-200/60 dark:border-zinc-800/60">
        {track.description}
      </p>
    </header>

    <!-- Curriculum Controls: Search & Sort Filter -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-3 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/70 dark:bg-zinc-900/60 backdrop-blur-xs">
      <!-- Search Input within this Series -->
      <div class="relative flex-1">
        <svg class="w-4 h-4 text-zinc-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          id="series-search-input"
          type="text"
          placeholder="이 시리즈 내 아티클 검색 (제목, 키워드)..."
          class="w-full pl-9 pr-3 py-1.5 text-xs rounded-xl border border-zinc-200 dark:border-zinc-700/80 bg-zinc-50 dark:bg-zinc-950/60 text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 focus:outline-hidden focus:ring-1 focus:ring-blue-500"
        />
      </div>

      <!-- Sort Toggle (Chronological 1편부터 vs Reverse Latest) -->
      <div class="flex items-center gap-1.5 text-xs shrink-0 self-end sm:self-auto">
        <span class="text-zinc-400 text-[11px] font-medium mr-1">정렬:</span>
        <button
          id="sort-asc-btn"
          type="button"
          class="px-2.5 py-1 rounded-lg bg-blue-600 text-white font-semibold text-[11px] transition-colors cursor-pointer"
        >
          1편부터 순서대로 (기초 &rarr; 심화)
        </button>
        <button
          id="sort-desc-btn"
          type="button"
          class="px-2.5 py-1 rounded-lg border border-zinc-200 dark:border-zinc-700/80 text-zinc-600 dark:text-zinc-400 font-medium text-[11px] hover:border-zinc-300 dark:hover:border-zinc-600 transition-colors cursor-pointer"
        >
          최신순
        </button>
      </div>
    </div>

    <!-- Curriculum Articles List -->
    <div id="curriculum-container" class="space-y-3">
      {curriculum.map((item) => (
        <article
          class="curriculum-item group p-4 sm:p-5 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/60 dark:bg-zinc-900/40 hover:bg-white dark:hover:bg-zinc-900 hover:border-blue-500/60 dark:hover:border-blue-500/60 hover:shadow-sm transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-4"
          data-title={item.title.toLowerCase()}
          data-tags={item.tags.join(' ').toLowerCase()}
          data-index={item.index}
          data-date={item.date}
        >
          <div class="flex items-start gap-3.5 min-w-0 flex-1">
            <span class="curriculum-num px-2 py-1 rounded-lg bg-blue-500/10 text-blue-600 dark:text-blue-400 font-mono font-bold text-xs shrink-0 self-start">
              #{String(item.index).padStart(2, '0')}
            </span>
            <div class="min-w-0">
              <a href={item.url} class="block group">
                <h3 class="font-bold text-sm sm:text-base text-zinc-900 dark:text-zinc-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors leading-snug">
                  {item.title}
                </h3>
              </a>
              <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1 line-clamp-1 leading-relaxed">
                {item.excerpt}
              </p>
              <div class="flex flex-wrap items-center gap-2 mt-2 text-[11px] text-zinc-400 font-mono">
                <time datetime={item.date}>{item.date}</time>
                <span>&bull;</span>
                <span>⏱ 약 {item.readingTime}분 소요</span>
                {item.tags.length > 0 && (
                  <>
                    <span>&bull;</span>
                    <div class="flex flex-wrap gap-1">
                      {item.tags.map((t: string) => (
                        <span class="px-1.5 py-0.2 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-500 dark:text-zinc-400 text-[10px]">
                          #{t}
                        </span>
                      ))}
                    </div>
                  </>
                )}
              </div>
            </div>
          </div>

          <a
            href={item.url}
            class="inline-flex items-center gap-1 text-xs font-semibold text-blue-600 dark:text-blue-400 group-hover:translate-x-0.5 transition-transform shrink-0 self-end sm:self-center"
          >
            <span>읽어보기</span>
            <span>&rarr;</span>
          </a>
        </article>
      ))}
    </div>

    <!-- Empty search result state -->
    <div id="no-results" class="hidden py-12 text-center text-xs text-zinc-400">
      검색된 아티클이 없습니다. 다른 키워드로 검색해 보세요.
    </div>
  </div>

  <script is:inline>
    (() => {
      const searchInput = document.getElementById('series-search-input');
      const container = document.getElementById('curriculum-container');
      const noResults = document.getElementById('no-results');
      const sortAscBtn = document.getElementById('sort-asc-btn');
      const sortDescBtn = document.getElementById('sort-desc-btn');

      if (!container) return;
      const items = Array.from(container.querySelectorAll('.curriculum-item'));

      // 1. Search Filter
      searchInput?.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        let visibleCount = 0;

        items.forEach((item) => {
          const title = item.dataset.title || '';
          const tags = item.dataset.tags || '';
          const matches = !query || title.includes(query) || tags.includes(query);
          item.style.display = matches ? '' : 'none';
          if (matches) visibleCount++;
        });

        if (noResults) {
          noResults.classList.toggle('hidden', visibleCount > 0);
        }
      });

      // 2. Sort Toggle
      function setSort(ascending) {
        if (ascending) {
          sortAscBtn.className = 'px-2.5 py-1 rounded-lg bg-blue-600 text-white font-semibold text-[11px] transition-colors cursor-pointer';
          sortDescBtn.className = 'px-2.5 py-1 rounded-lg border border-zinc-200 dark:border-zinc-700/80 text-zinc-600 dark:text-zinc-400 font-medium text-[11px] hover:border-zinc-300 dark:hover:border-zinc-600 transition-colors cursor-pointer';
        } else {
          sortDescBtn.className = 'px-2.5 py-1 rounded-lg bg-blue-600 text-white font-semibold text-[11px] transition-colors cursor-pointer';
          sortAscBtn.className = 'px-2.5 py-1 rounded-lg border border-zinc-200 dark:border-zinc-700/80 text-zinc-600 dark:text-zinc-400 font-medium text-[11px] hover:border-zinc-300 dark:hover:border-zinc-600 transition-colors cursor-pointer';
        }

        const sorted = [...items].sort((a, b) => {
          const idxA = parseInt(a.dataset.index || '0', 10);
          const idxB = parseInt(b.dataset.index || '0', 10);
          return ascending ? idxA - idxB : idxB - idxA;
        });

        sorted.forEach((el) => container.appendChild(el));
      }

      sortAscBtn?.addEventListener('click', () => setSort(true));
      sortDescBtn?.addEventListener('click', () => setSort(false));
    })();
  </script>
</BaseLayout>
