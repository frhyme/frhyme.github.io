---
import { getCollection, render } from 'astro:content';
import PostLayout from '../layouts/PostLayout.astro';

export async function getStaticPaths() {
  function getPostUrl(post: any) {
    if (post.data.permalink) {
      const clean = post.data.permalink.replace(/^\/+|\/+$/g, '');
      return `/${clean}/`;
    }
    const filename = post.id.replace(/\.md$/, '');
    const slugMatch = filename.match(/^(\d{4}-\d{2}-\d{2})-(.*)$/);
    const postSlug = slugMatch ? slugMatch[2] : filename;
    const cat = (post.data.category || 'others').toLowerCase().replace(/\s+/g, '-');
    return `/${cat}/${postSlug}/`;
  }

  const posts = await getCollection('posts');
  const sortedPosts = posts.sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  );

  const postMetaList = sortedPosts.map((p) => ({
    id: p.id,
    title: p.data.title,
    url: getPostUrl(p),
    category: p.data.category || 'others',
    tags: (p.data.tags || []).map((t: string) => t.toLowerCase().trim()).filter(Boolean),
    date: p.data.date ? new Date(p.data.date).toISOString().split('T')[0] : '',
  }));

  // Inverted index by tag and category for fast related post scoring
  const tagIndex = new Map<string, number[]>();
  const catIndex = new Map<string, number[]>();

  postMetaList.forEach((p, idx) => {
    p.tags.forEach((tag) => {
      if (!tagIndex.has(tag)) tagIndex.set(tag, []);
      tagIndex.get(tag)!.push(idx);
    });
    const cat = p.category.toLowerCase();
    if (!catIndex.has(cat)) catIndex.set(cat, []);
    catIndex.get(cat)!.push(idx);
  });

  return sortedPosts.map((post, index) => {
    // Determine route slug from permalink or filename
    let routeSlug: string;
    if (post.data.permalink) {
      routeSlug = post.data.permalink.replace(/^\/+|\/+$/g, '');
    } else {
      const filename = post.id.replace(/\.md$/, '');
      const slugMatch = filename.match(/^(\d{4}-\d{2}-\d{2})-(.*)$/);
      const postSlug = slugMatch ? slugMatch[2] : filename;
      const cat = (post.data.category || 'others').toLowerCase().replace(/\s+/g, '-');
      routeSlug = `${cat}/${postSlug}`;
    }

    const segments = routeSlug.split('/');
    const identifier = segments[segments.length - 1];

    // Newer post (written later)
    const nextPost =
      index > 0
        ? {
            title: sortedPosts[index - 1].data.title,
            url: getPostUrl(sortedPosts[index - 1]),
            category: sortedPosts[index - 1].data.category || 'others',
          }
        : null;

    // Older post (written earlier)
    const prevPost =
      index < sortedPosts.length - 1
        ? {
            title: sortedPosts[index + 1].data.title,
            url: getPostUrl(sortedPosts[index + 1]),
            category: sortedPosts[index + 1].data.category || 'others',
          }
        : null;

    // Calculate related posts using tag/category overlap
    const currentMeta = postMetaList[index];
    const scoreMap = new Map<number, number>();

    currentMeta.tags.forEach((tag) => {
      const matchingIndices = tagIndex.get(tag) || [];
      matchingIndices.forEach((idx) => {
        if (idx !== index) {
          scoreMap.set(idx, (scoreMap.get(idx) || 0) + 3);
        }
      });
    });

    const sameCatIndices = catIndex.get(currentMeta.category.toLowerCase()) || [];
    sameCatIndices.forEach((idx) => {
      if (idx !== index) {
        scoreMap.set(idx, (scoreMap.get(idx) || 0) + 1);
      }
    });

    const relatedPosts = Array.from(scoreMap.entries())
      .sort((a, b) => b[1] - a[1])
      .slice(0, 3)
      .map(([idx]) => ({
        title: postMetaList[idx].title,
        url: postMetaList[idx].url,
        category: postMetaList[idx].category,
        date: postMetaList[idx].date,
      }));

    // Series Sequential Navigator (1편 -> N편 순서)
    function getSeriesKey(category: string, tags: string[]): string | null {
      const lowerCat = (category || '').toLowerCase();
      const tagSet = new Set((tags || []).map((t) => t.toLowerCase().trim()));
      if (tagSet.has('networkx') || tagSet.has('centrality') || tagSet.has('bipartite')) {
        return 'networkx';
      }
      if (lowerCat === 'algorithm' || tagSet.has('algorithm') || tagSet.has('tree') || tagSet.has('linkedlist') || tagSet.has('dp')) {
        return 'algorithm';
      }
      if (lowerCat === 'java' || tagSet.has('java')) {
        return 'java';
      }
      if (lowerCat === 'python' || tagSet.has('python')) {
        return 'python';
      }
      return null;
    }

    const seriesTitles: Record<string, string> = {
      networkx: 'NetworkX & 그래프 데이터 사이언스',
      python: 'Python Deep-Dive & 내부 메커니즘',
      algorithm: '자료구조 & 코딩 테스트 문제 해결 패턴',
      java: 'Java & 엔터프라이즈 객체지향 아키텍처',
    };

    const seriesKey = getSeriesKey(post.data.category || '', post.data.tags || []);
    let seriesNav = null;
    if (seriesKey) {
      // Collect matching posts in chronological order (step 1 -> step N)
      const chronPosts = [...sortedPosts]
        .reverse()
        .filter((p) => getSeriesKey(p.data.category || '', p.data.tags || []) === seriesKey);
      const sIdx = chronPosts.findIndex((p) => p.id === post.id);
      if (sIdx !== -1) {
        seriesNav = {
          seriesId: seriesKey,
          seriesName: seriesTitles[seriesKey],
          seriesUrl: `/series/${seriesKey}/`,
          currentIndex: sIdx + 1,
          totalCount: chronPosts.length,
          prevPost:
            sIdx > 0
              ? {
                  title: chronPosts[sIdx - 1].data.title,
                  url: getPostUrl(chronPosts[sIdx - 1]),
                }
              : null,
          nextPost:
            sIdx < chronPosts.length - 1
              ? {
                  title: chronPosts[sIdx + 1].data.title,
                  url: getPostUrl(chronPosts[sIdx + 1]),
                }
              : null,
        };
      }
    }

    return {
      params: {
        slug: routeSlug,
      },
      props: {
        post,
        identifier,
        prevPost,
        nextPost,
        relatedPosts,
        seriesNav,
        filePath: post.id,
      },
    };
  });
}

import { cleanExcerpt, getReadingTime } from '../utils/excerpt';

const { post, identifier, prevPost, nextPost, relatedPosts, seriesNav, filePath } = Astro.props;
const { Content, headings } = await render(post);

const description = post.data.description || cleanExcerpt(post.body);
const readingTimeMinutes = getReadingTime(post.body);
---

<PostLayout
  title={post.data.title}
  date={post.data.date}
  category={post.data.category}
  tags={post.data.tags}
  headings={headings}
  slug={identifier}
  prevPost={prevPost}
  nextPost={nextPost}
  relatedPosts={relatedPosts}
  seriesNav={seriesNav}
  filePath={filePath}
  readingTime={readingTimeMinutes}
  description={description}
>
  <Content />
</PostLayout>
