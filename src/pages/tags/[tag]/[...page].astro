---
import type { GetStaticPathsOptions, Page } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import Pagination from '../../../components/Pagination.astro';
import { cleanExcerpt, getReadingTime } from '../../../utils/excerpt';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection('posts');

  const tagCoOccurrence = new Map<string, Map<string, number>>();
  const tags = new Set<string>();

  for (const post of posts) {
    const cleanTags = Array.from(
      new Set((post.data.tags || []).map((t: string) => t.toLowerCase().trim()).filter(Boolean))
    );

    for (const t of cleanTags) {
      tags.add(t);
      if (!tagCoOccurrence.has(t)) tagCoOccurrence.set(t, new Map());
    }

    for (let i = 0; i < cleanTags.length; i++) {
      for (let j = 0; j < cleanTags.length; j++) {
        if (i !== j) {
          const u = cleanTags[i];
          const v = cleanTags[j];
          const m = tagCoOccurrence.get(u)!;
          m.set(v, (m.get(v) || 0) + 1);
        }
      }
    }
  }

  return Array.from(tags).flatMap((tag) => {
    const filteredPosts = posts
      .filter((p) =>
        (p.data.tags || []).some((t) => t.toLowerCase().trim() === tag)
      )
      .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

    const coMap = tagCoOccurrence.get(tag);
    const relatedTags = coMap
      ? Array.from(coMap.entries())
          .sort((a, b) => b[1] - a[1])
          .slice(0, 6)
          .map(([name, count]) => ({ name, count }))
      : [];

    return paginate(filteredPosts, {
      params: { tag },
      props: { relatedTags },
      pageSize: 16,
    });
  });
}

interface Props {
  page: Page<CollectionEntry<'posts'>>;
  relatedTags: Array<{ name: string; count: number }>;
}

const { page, relatedTags = [] } = Astro.props;
const { tag } = Astro.params;
---

<BaseLayout title={`Tag: #${tag} (Page ${page.currentPage})`}>
  <div class="mb-8 pb-5 border-b border-zinc-200/80 dark:border-zinc-800/80 space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div>
        <div class="flex items-center space-x-2 text-xs text-zinc-400 mb-1">
          <a href="/tags/" class="hover:underline">Tags</a>
          <span>&gt;</span>
          <span class="text-zinc-600 dark:text-zinc-300 font-medium">#{tag}</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50">
          #{tag}
        </h1>
        <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1">
          총 {page.total.toLocaleString()}개의 아티클
        </p>
      </div>
      <span class="text-xs px-2.5 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 font-mono self-start sm:self-auto">
        Page {page.currentPage} of {page.lastPage}
      </span>
    </div>

    <!-- Related Tags connected in Knowledge Graph -->
    {relatedTags && relatedTags.length > 0 && (
      <div class="flex flex-wrap items-center gap-1.5 pt-3 border-t border-zinc-100 dark:border-zinc-800/60 text-xs">
        <span class="text-zinc-400 font-medium mr-1">함께 자주 쓰인 연관 태그:</span>
        {relatedTags.map((rt) => (
          <a
            href={`/tags/${rt.name}/`}
            class="inline-flex items-center px-2.5 py-1 rounded-lg border border-zinc-200/80 dark:border-zinc-800 bg-white/70 dark:bg-zinc-900/50 text-zinc-600 dark:text-zinc-400 hover:border-blue-500 hover:text-blue-600 dark:hover:border-blue-400 dark:hover:text-blue-400 font-mono text-[11px] transition-colors"
          >
            <span>#{rt.name}</span>
            <span class="ml-1 text-zinc-400 text-[10px]">({rt.count})</span>
          </a>
        ))}
      </div>
    )}
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-8">
    {page.data.map((post) => {
      let url = post.data.permalink;
      if (!url) {
        const filename = post.id.replace(/\.md$/, '');
        const slugMatch = filename.match(/^(\d{4}-\d{2}-\d{2})-(.*)$/);
        const postSlug = slugMatch ? slugMatch[2] : filename;
        const cat = (post.data.category || 'others').toLowerCase().replace(/\s+/g, '-');
        url = `/${cat}/${postSlug}/`;
      }

      const description = post.data.description || cleanExcerpt(post.body);
      const readingTime = getReadingTime(post.body);

      return (
        <PostCard
          title={post.data.title}
          date={post.data.date}
          category={post.data.category}
          tags={post.data.tags}
          url={url}
          description={description}
          readingTime={readingTime}
        />
      );
    })}
  </div>

  <Pagination
    currentPage={page.currentPage}
    lastPage={page.lastPage}
    basePath={`/tags/${tag}/`}
  />
</BaseLayout>
