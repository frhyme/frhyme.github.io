---
import type { GetStaticPathsOptions, Page } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';
import { cleanExcerpt, getReadingTime } from '../../utils/excerpt';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection('posts');
  const sortedPosts = posts.sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  );

  return paginate(sortedPosts, { pageSize: 16 });
}

interface Props {
  page: Page<CollectionEntry<'posts'>>;
}

const { page } = Astro.props;
---

<BaseLayout title={`All Posts - Page ${page.currentPage}`}>
  <div class="mb-8 pb-5 border-b border-zinc-200/80 dark:border-zinc-800/80 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50">
        All Posts
      </h1>
      <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1">
        총 {page.total.toLocaleString()}개의 아카이브 중 {page.start + 1} - {page.end + 1}번째 글
      </p>
    </div>
    <span class="text-xs px-2.5 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 font-mono self-start sm:self-auto">
      Page {page.currentPage} of {page.lastPage}
    </span>
  </div>

  <div id="posts-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-8">
    {page.data.map((post) => {
      let url = post.data.permalink;
      if (!url) {
        const filename = post.id.replace(/\.md$/, '');
        const slugMatch = filename.match(/^(\d{4}-\d{2}-\d{2})-(.*)$/);
        const postSlug = slugMatch ? slugMatch[2] : filename;
        const category = (post.data.category || 'others').toLowerCase().replace(/\s+/g, '-');
        url = `/${category}/${postSlug}/`;
      }

      const description = post.data.description || cleanExcerpt(post.body);
      const readingTime = getReadingTime(post.body);

      return (
        <PostCard
          title={post.data.title}
          date={post.data.date}
          category={post.data.category}
          tags={post.data.tags}
          url={url}
          description={description}
          readingTime={readingTime}
        />
      );
    })}
  </div>

  <Pagination currentPage={page.currentPage} lastPage={page.lastPage} />
</BaseLayout>
