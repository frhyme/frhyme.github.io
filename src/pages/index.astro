---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import AdSense from '../components/AdSense.astro';

const allPosts = await getCollection('posts');

// Sort posts descending by date
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const recentPosts = sortedPosts.slice(0, 15);

// Category stats
const categoryCounts: Record<string, number> = {};
for (const post of allPosts) {
  const cat = (post.data.category || 'others').toLowerCase();
  categoryCounts[cat] = (categoryCounts[cat] || 0) + 1;
}

const topCategories = Object.entries(categoryCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8);
---

<BaseLayout title="frhyme.code">
  <!-- Hero Section -->
  <section class="py-8 border-b border-zinc-200 dark:border-zinc-800">
    <div class="flex items-center space-x-3 mb-3">
      <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
      <span class="text-xs uppercase tracking-wider font-semibold text-zinc-500 dark:text-zinc-400">
        Personal Engineering Knowledge Base
      </span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50">
      study, code, re-study
    </h1>
    <p class="mt-2 text-zinc-600 dark:text-zinc-400 max-w-2xl text-sm sm:text-base leading-relaxed">
      파이썬, 네트워크 분석, 알고리즘 및 소프트웨어 개발 과정에서 배우고 정리한 {allPosts.length.toLocaleString()}개의 지식 기록입니다.
    </p>

    <!-- Top Categories Quick Chips -->
    <div class="flex flex-wrap items-center gap-2 mt-5">
      <span class="text-xs text-zinc-400 font-medium">인기 주제:</span>
      {topCategories.map(([cat, count]) => (
        <a
          href={`/categories/${cat}/`}
          class="text-xs px-2.5 py-1 rounded-lg border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 hover:border-blue-500 hover:text-blue-600 dark:hover:border-blue-400 dark:hover:text-blue-400 transition-colors"
        >
          {cat} <span class="text-zinc-400 ml-0.5">({count})</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Top AdSense Banner -->
  <AdSense slot="8429315249" className="my-6" />

  <!-- Post List -->
  <section class="mt-8">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
        Latest Posts
      </h2>
      <a href="/page/2/" class="text-xs font-medium text-blue-600 dark:text-blue-400 hover:underline">
        전체 {allPosts.length.toLocaleString()}개 글 목록 &rarr;
      </a>
    </div>

    <div class="divide-y divide-zinc-100 dark:divide-zinc-800">
      {recentPosts.map((post) => {
        let url = post.data.permalink;
        if (!url) {
          const filename = post.id.replace(/\.md$/, '');
          const slugMatch = filename.match(/^(\d{4}-\d{2}-\d{2})-(.*)$/);
          const postSlug = slugMatch ? slugMatch[2] : filename;
          const category = (post.data.category || 'others').toLowerCase().replace(/\s+/g, '-');
          url = `/${category}/${postSlug}/`;
        }

        return (
          <PostCard
            title={post.data.title}
            date={post.data.date}
            category={post.data.category}
            tags={post.data.tags}
            url={url}
          />
        );
      })}
    </div>

    <!-- More Posts Button -->
    <div class="text-center mt-12 pt-6 border-t border-zinc-200 dark:border-zinc-800">
      <a
        href="/page/2/"
        class="inline-flex items-center px-6 py-3 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 text-sm font-semibold text-zinc-800 dark:text-zinc-200 hover:bg-zinc-50 dark:hover:bg-zinc-800 shadow-sm transition-all"
      >
        다음 페이지로 이동 (Page 2) &rarr;
      </a>
    </div>
  </section>
</BaseLayout>
