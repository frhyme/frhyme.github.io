---
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 w-full backdrop-blur-md bg-white/80 dark:bg-zinc-950/80 border-b border-zinc-200/80 dark:border-zinc-800/80 transition-colors">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-8 h-8 rounded-xl bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-950 flex items-center justify-center font-mono font-bold text-xs shadow-sm group-hover:scale-105 transition-transform">
        f_
      </div>
      <div class="flex items-center text-lg font-bold tracking-tight text-zinc-900 dark:text-zinc-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
        <span>frhyme<span class="text-zinc-400 dark:text-zinc-500 font-normal">.code</span></span>
      </div>
    </a>

    <!-- Nav Links with Major Categories -->
    <nav class="flex items-center space-x-1 sm:space-x-2 text-sm font-medium text-zinc-600 dark:text-zinc-400">
      <a
        href="/tech/"
        class:list={[
          "px-2.5 py-1.5 rounded-lg hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-all",
          currentPath.startsWith('/tech') && "text-blue-600 dark:text-blue-400 bg-blue-50/50 dark:bg-blue-950/40 font-semibold"
        ]}
      >
        <span class="hidden sm:inline">💻 </span>Tech
      </a>
      <a
        href="/english/"
        class:list={[
          "px-2.5 py-1.5 rounded-lg hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-all",
          currentPath.startsWith('/english') && "text-emerald-600 dark:text-emerald-400 bg-emerald-50/50 dark:bg-emerald-950/40 font-semibold"
        ]}
      >
        <span class="hidden sm:inline">📚 </span>English
      </a>
      <a
        href="/life/"
        class:list={[
          "px-2.5 py-1.5 rounded-lg hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-all",
          currentPath.startsWith('/life') && "text-amber-600 dark:text-amber-400 bg-amber-50/50 dark:bg-amber-950/40 font-semibold"
        ]}
      >
        <span class="hidden sm:inline">☕ </span>Life
      </a>
      <a
        href="/categories/"
        class:list={[
          "hidden md:inline px-2.5 py-1.5 rounded-lg hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-all",
          currentPath.startsWith('/categories') && "text-blue-600 dark:text-blue-400 bg-zinc-100 dark:bg-zinc-900 font-semibold"
        ]}
      >
        Categories
      </a>
      <a
        href="/tags/"
        class:list={[
          "hidden md:inline px-2.5 py-1.5 rounded-lg hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-all",
          currentPath.startsWith('/tags') && "text-blue-600 dark:text-blue-400 bg-zinc-100 dark:bg-zinc-900 font-semibold"
        ]}
      >
        Tags
      </a>
      <a
        href="/about/"
        class:list={[
          "px-2.5 py-1.5 rounded-lg hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-all",
          currentPath.startsWith('/about') && "text-blue-600 dark:text-blue-400 bg-zinc-100 dark:bg-zinc-900 font-semibold"
        ]}
      >
        About
      </a>
    </nav>

    <!-- Right utilities -->
    <div class="flex items-center space-x-2">
      <!-- Search button with Cmd+K hint -->
      <a
        href="/search/"
        id="nav-search-btn"
        class:list={[
          "flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-zinc-200/80 dark:border-zinc-800 bg-zinc-100/70 dark:bg-zinc-900/60 text-xs text-zinc-600 dark:text-zinc-400 hover:border-zinc-300 dark:hover:border-zinc-700 hover:text-zinc-900 dark:hover:text-zinc-100 transition-all",
          currentPath.startsWith('/search') && "border-blue-500/50 text-blue-600 dark:text-blue-400"
        ]}
        title="검색 (단축키: Cmd+K 또는 /)"
      >
        <svg xmlns="http://www.w3.org/2001/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span class="hidden sm:inline">Search</span>
        <kbd class="hidden sm:inline-block px-1.5 py-0.5 rounded text-[10px] bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 font-mono text-zinc-400">⌘K</kbd>
      </a>

      <!-- Dark mode toggle -->
      <button
        id="theme-toggle"
        aria-label="Toggle theme"
        class="p-2 rounded-lg text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors cursor-pointer"
      >
        <!-- Sun icon -->
        <svg id="sun-icon" class="w-4 h-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 9H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon icon -->
        <svg id="moon-icon" class="w-4 h-4 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- GitHub link -->
      <a
        href="https://github.com/frhyme"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub Profile"
        class="p-2 rounded-lg text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
        </svg>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    // Theme toggle
    const themeToggle = document.getElementById('theme-toggle');
    themeToggle?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });

    // Keyboard shortcut for search (Cmd+K or /)
    document.addEventListener('keydown', (e) => {
      const target = e.target;
      if (
        target instanceof HTMLInputElement ||
        target instanceof HTMLTextAreaElement ||
        (target && target.isContentEditable)
      ) {
        return;
      }
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        window.location.href = '/search/';
      } else if (e.key === '/' && !e.metaKey && !e.ctrlKey) {
        e.preventDefault();
        window.location.href = '/search/';
      }
    });
  })();
</script>
