---
import { getMajorCategory } from '../utils/categories';

interface Props {
  title: string;
  date: Date;
  category: string;
  tags?: string[];
  url: string;
  description?: string;
  readingTime?: number;
}

const { title, date, category, tags = [], url, description, readingTime } = Astro.props;

const formattedDate = date ? new Date(date).toISOString().split('T')[0] : '';
const major = getMajorCategory(category);

// Color accent per major category
const categoryBadgeClass =
  major === 'tech'
    ? 'bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/20 group-hover:bg-blue-500/20'
    : major === 'english'
    ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20 group-hover:bg-emerald-500/20'
    : 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/20 group-hover:bg-amber-500/20';
---

<article class="group relative flex flex-col justify-between p-5 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/80 dark:bg-zinc-900/40 hover:bg-white dark:hover:bg-zinc-900/70 hover:border-zinc-300 dark:hover:border-zinc-700 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200">
  <div>
    <!-- Top Meta Row -->
    <div class="flex items-center justify-between text-xs mb-3 gap-2">
      <a
        href={`/categories/${category.toLowerCase()}/`}
        class:list={[
          "relative z-10 px-2.5 py-0.5 rounded-md font-semibold text-[11px] uppercase tracking-wider border transition-colors",
          categoryBadgeClass
        ]}
      >
        {category}
      </a>

      <div class="flex items-center gap-1.5 text-zinc-400 dark:text-zinc-500 text-[11px] font-mono shrink-0">
        <time datetime={formattedDate}>{formattedDate}</time>
        {readingTime && (
          <>
            <span>·</span>
            <span>⏱ {readingTime}m</span>
          </>
        )}
      </div>
    </div>

    <!-- Title -->
    <h3 class="text-base sm:text-lg font-bold tracking-tight text-zinc-900 dark:text-zinc-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2 leading-snug">
      <a href={url} class="after:absolute after:inset-0">
        {title}
      </a>
    </h3>

    <!-- Excerpt / Description -->
    {description && (
      <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mt-2 line-clamp-2 leading-relaxed font-normal">
        {description}
      </p>
    )}
  </div>

  <!-- Tags -->
  {tags.length > 0 && (
    <div class="relative z-10 flex flex-wrap gap-1.5 mt-4 pt-3 border-t border-zinc-100 dark:border-zinc-800/60">
      {tags.slice(0, 3).map((t) => (
        <a
          href={`/tags/${t.toLowerCase()}/`}
          class="text-[11px] px-2 py-0.5 rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-500 dark:text-zinc-400 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors"
        >
          #{t}
        </a>
      ))}
      {tags.length > 3 && (
        <span class="text-[11px] px-1 py-0.5 text-zinc-400">+{tags.length - 3}</span>
      )}
    </div>
  )}
</article>
