---
import BaseLayout from './BaseLayout.astro';
import AdSense from '../components/AdSense.astro';
import TableOfContents from '../components/TableOfContents.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface PostNav {
  title: string;
  url: string;
  category: string;
}

interface Props {
  title: string;
  date: Date;
  category: string;
  tags?: string[];
  headings: Heading[];
  slug: string;
  prevPost?: PostNav | null;
  nextPost?: PostNav | null;
  relatedPosts?: Array<{
    title: string;
    url: string;
    category: string;
    date: string;
  }>;
  seriesNav?: {
    seriesId: string;
    seriesName: string;
    seriesUrl: string;
    currentIndex: number;
    totalCount: number;
    prevPost: { title: string; url: string } | null;
    nextPost: { title: string; url: string } | null;
  } | null;
  filePath?: string;
  readingTime?: number;
  description?: string;
}

const {
  title,
  date,
  category,
  tags = [],
  headings = [],
  slug,
  prevPost,
  nextPost,
  relatedPosts = [],
  seriesNav,
  filePath,
  readingTime,
  description,
} = Astro.props;

const formattedDate = date ? new Date(date).toISOString().split('T')[0] : '';
const currentUrl = new URL(Astro.url.pathname, Astro.site).toString();
const filteredHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);

// Outdated content calculation (3+ years old)
const postDate = date ? new Date(date) : null;
const now = new Date();
const yearsAgo = postDate
  ? Math.floor((now.getTime() - postDate.getTime()) / (1000 * 60 * 60 * 24 * 365.25))
  : 0;
const isOutdated = yearsAgo >= 3;

// Check if post belongs to one of the 4 signature curated series
const lowerCategory = (category || '').toLowerCase();
const tagSet = new Set((tags || []).map((t) => t.toLowerCase().trim()));

let seriesInfo: { title: string; subtitle: string; icon: string; url: string; count: string } | null = null;

if (tagSet.has('networkx') || tagSet.has('centrality') || tagSet.has('bipartite')) {
  seriesInfo = {
    title: 'NetworkX & 그래프 데이터 사이언스 시리즈',
    subtitle: '노드·엣지 제어부터 중심성 지표, 커뮤니티 탐지 및 네트워크 시각화 로드맵',
    icon: '🕸',
    url: '/series/networkx/',
    count: '140+편',
  };
} else if (lowerCategory === 'algorithm' || tagSet.has('algorithm') || tagSet.has('tree') || tagSet.has('linkedlist') || tagSet.has('dp')) {
  seriesInfo = {
    title: '자료구조 & 코딩 테스트 문제 해결 패턴',
    subtitle: '대표적인 자료구조 구현과 빈출 코딩 테스트 핵심 알고리즘 패턴',
    icon: '⚡',
    url: '/series/algorithm/',
    count: '90+편',
  };
} else if (lowerCategory === 'java' || tagSet.has('java')) {
  seriesInfo = {
    title: 'Java & 엔터프라이즈 객체지향 아키텍처',
    subtitle: '객체지향 설계 원칙(SOLID), JVM 메모리 구조, 실전 디자인 패턴과 JDBC',
    icon: '☕',
    url: '/series/java/',
    count: '140+편',
  };
} else if (lowerCategory === 'python' || tagSet.has('python')) {
  seriesInfo = {
    title: 'Python Deep-Dive & 내부 메커니즘 시리즈',
    subtitle: '파이썬 런타임의 동작 원리, 이터레이터, 데코레이터 및 동시성 최적화',
    icon: '🐍',
    url: '/series/python/',
    count: '620+편',
  };
}

// Breadcrumbs for Google SEO Rich Snippets and user navigation
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: category, url: `/categories/${category.toLowerCase()}/` },
  ...(seriesInfo ? [{ name: seriesInfo.title.split(' ')[0] + ' 시리즈', url: seriesInfo.url }] : []),
  { name: title, url: currentUrl },
];
---

<BaseLayout title={title} description={description} articleDate={formattedDate} breadcrumbs={breadcrumbs}>
  <!-- Top Reading Progress Bar -->
  <div
    id="reading-progress"
    class="fixed top-0 left-0 w-0 h-0.5 bg-blue-600 dark:bg-blue-400 z-50 transition-[width] duration-75 ease-out pointer-events-none"
    style="width: 0%;"
  ></div>

  <div class="lg:grid lg:grid-cols-12 lg:gap-10">
    <!-- Main Article Content -->
    <article class="lg:col-span-8 min-w-0" data-pagefind-body>
      <!-- Post Meta Header -->
      <header class="mb-8 pb-6 border-b border-zinc-200 dark:border-zinc-800">
        <!-- Breadcrumb trail -->
        <nav class="flex items-center space-x-1.5 text-xs text-zinc-400 mb-3 font-medium flex-wrap" aria-label="Breadcrumb">
          <a href="/" class="hover:text-zinc-700 dark:hover:text-zinc-200 transition-colors">Home</a>
          <span>/</span>
          <a href={`/categories/${category.toLowerCase()}/`} class="hover:text-zinc-700 dark:hover:text-zinc-200 uppercase tracking-wider transition-colors">
            {category}
          </a>
          {seriesInfo && (
            <>
              <span>/</span>
              <a href={seriesInfo.url} class="hover:text-blue-600 dark:hover:text-blue-400 text-blue-600/90 dark:text-blue-400/90 transition-colors">
                {seriesInfo.title.split(' ')[0]} 시리즈
              </a>
            </>
          )}
        </nav>

        <div class="flex flex-wrap items-center justify-between gap-3 text-xs text-zinc-500 dark:text-zinc-400 mb-3">
          <div class="flex flex-wrap items-center gap-2">
            <time datetime={formattedDate}>{formattedDate}</time>
            <span>&bull;</span>
            <a
              href={`/categories/${category.toLowerCase()}/`}
              class="font-semibold text-blue-600 dark:text-blue-400 hover:underline uppercase tracking-wider"
            >
              {category}
            </a>
            {readingTime && (
              <>
                <span>&bull;</span>
                <span class="text-zinc-500 dark:text-zinc-400 flex items-center gap-1">
                  ⏱ 약 {readingTime}분 소요
                </span>
              </>
            )}
          </div>

          <button
            id="share-btn"
            type="button"
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/60 hover:border-zinc-300 dark:hover:border-zinc-700 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 text-[11px] font-medium transition-all cursor-pointer shadow-2xs"
            title="글 주소 복사하기"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
            </svg>
            <span>URL 복사</span>
          </button>
        </div>

        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50 leading-tight">
          {title}
        </h1>

        {tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-4">
            {tags.map((t) => (
              <a
                href={`/tags/${t.toLowerCase()}/`}
                class="text-xs px-2.5 py-1 rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300 hover:bg-blue-50 hover:text-blue-600 dark:hover:bg-zinc-700 transition-colors"
              >
                #{t}
              </a>
            ))}
          </div>
        )}
      </header>

      <!-- Series Roadmap Track Banner -->
      {seriesInfo && (
        <aside class="mb-8 p-4 rounded-2xl border border-blue-500/20 bg-gradient-to-r from-blue-50/50 via-indigo-50/20 to-transparent dark:from-blue-950/20 dark:via-indigo-950/10 dark:to-transparent text-xs flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-2xs">
          <div class="flex items-center gap-3">
            <span class="text-xl p-2 rounded-xl bg-blue-500/10 text-blue-600 dark:text-blue-400 shrink-0">
              {seriesInfo.icon}
            </span>
            <div>
              <div class="flex items-center gap-2">
                <span class="font-bold text-zinc-900 dark:text-zinc-100 text-xs sm:text-sm">
                  {seriesInfo.title}
                </span>
                <span class="px-2 py-0.2 rounded-md bg-blue-500/10 text-blue-600 dark:text-blue-400 text-[10px] font-mono font-semibold">
                  {seriesInfo.count}
                </span>
              </div>
              <p class="text-zinc-500 dark:text-zinc-400 mt-0.5 line-clamp-1">
                {seriesInfo.subtitle}
              </p>
            </div>
          </div>
          <a
            href={seriesInfo.url}
            class="inline-flex items-center gap-1 font-semibold text-blue-600 dark:text-blue-400 hover:underline shrink-0 self-start sm:self-auto text-xs group"
          >
            <span>전체 로드맵 & 커리큘럼</span>
            <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
          </a>
        </aside>
      )}

      <!-- Mobile Table of Contents (Collapsible) -->
      {filteredHeadings.length > 0 && (
        <div class="lg:hidden mb-8">
          <details class="group rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-900/60 p-4 transition-all">
            <summary class="flex items-center justify-between font-bold text-sm text-zinc-800 dark:text-zinc-200 cursor-pointer select-none">
              <span class="flex items-center gap-2">
                <span>📑</span> 목차 (Contents)
              </span>
              <svg class="w-4 h-4 text-zinc-400 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <ul class="mt-3 pt-3 border-t border-zinc-200/60 dark:border-zinc-800/60 space-y-1.5 text-xs text-zinc-600 dark:text-zinc-400">
              {filteredHeadings.map((h) => (
                <li class={h.depth === 3 ? 'pl-3' : ''}>
                  <a href={`#${h.slug}`} class="hover:text-blue-600 dark:hover:text-blue-400 block transition-colors py-0.5">
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </div>
      )}

      <!-- Outdated Post Notice Banner -->
      {isOutdated && (
        <aside class="mb-8 p-3.5 sm:p-4 rounded-2xl border border-amber-500/25 bg-amber-50/60 dark:bg-amber-950/20 text-xs text-amber-900 dark:text-amber-200 flex items-start gap-3 shadow-2xs">
          <span class="text-base sm:text-lg shrink-0 select-none">💡</span>
          <div class="leading-relaxed">
            <p class="font-bold text-amber-950 dark:text-amber-100 text-xs sm:text-sm">
              작성된 지 {yearsAgo}년 이상 지난 아티클입니다 ({formattedDate})
            </p>
            <p class="text-amber-800/80 dark:text-amber-300/80 mt-0.5">
              이 글은 작성된 지 시간이 다소 경과하여 최신 라이브러리/프레임워크 버전, 의존성 패키지 또는 언어 문법과 일부 차이가 있을 수 있으니 참고해 주시기 바랍니다.
            </p>
          </div>
        </aside>
      )}

      <!-- Markdown Prose Content -->
      <div class="prose dark:prose-invert">
        <slot />
      </div>

      <!-- Series Sequential Track Navigator -->
      {seriesNav && (
        <aside class="my-8 p-4 sm:p-5 rounded-2xl border border-blue-500/25 bg-blue-50/40 dark:bg-blue-950/20 shadow-2xs">
          <div class="flex items-center justify-between text-xs mb-3 pb-2.5 border-b border-blue-500/10">
            <div class="flex items-center gap-2">
              <span class="font-bold text-blue-600 dark:text-blue-400">
                {seriesNav.seriesName}
              </span>
              <span class="px-2 py-0.5 rounded-md bg-blue-500/10 text-blue-600 dark:text-blue-400 font-mono text-[10px] font-semibold">
                {seriesNav.currentIndex} / {seriesNav.totalCount}편
              </span>
            </div>
            <a href={seriesNav.seriesUrl} class="text-zinc-500 hover:text-blue-600 dark:text-zinc-400 dark:hover:text-blue-400 font-medium transition-colors">
              전체 커리큘럼 보기 &rarr;
            </a>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
            {seriesNav.prevPost ? (
              <a href={seriesNav.prevPost.url} class="p-3 rounded-xl border border-zinc-200/80 dark:border-zinc-800 bg-white/80 dark:bg-zinc-900/60 hover:border-blue-500 transition-colors flex flex-col justify-between group">
                <span class="text-zinc-400 font-medium mb-1">&larr; 시리즈 이전 편</span>
                <span class="font-semibold text-zinc-900 dark:text-zinc-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-1">{seriesNav.prevPost.title}</span>
              </a>
            ) : (
              <div class="p-3 rounded-xl border border-dashed border-zinc-200 dark:border-zinc-800 text-zinc-400 text-center flex items-center justify-center">
                시리즈의 첫 번째 글입니다 🚀
              </div>
            )}
            {seriesNav.nextPost ? (
              <a href={seriesNav.nextPost.url} class="p-3 rounded-xl border border-blue-500/40 bg-white/90 dark:bg-zinc-900/80 hover:border-blue-600 transition-colors flex flex-col justify-between sm:text-right group">
                <span class="text-blue-600 dark:text-blue-400 font-semibold mb-1">시리즈 다음 편 정주행 &rarr;</span>
                <span class="font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-1">{seriesNav.nextPost.title}</span>
              </a>
            ) : (
              <div class="p-3 rounded-xl border border-dashed border-zinc-200 dark:border-zinc-800 text-zinc-400 text-center flex items-center justify-center sm:text-right">
                시리즈의 마지막 편입니다 🎉
              </div>
            )}
          </div>
        </aside>
      )}

      <!-- GitHub Edit & Source Link -->
      {filePath && (
        <div class="mt-8 pt-4 pb-2 border-t border-zinc-200/80 dark:border-zinc-800/80 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs text-zinc-500 dark:text-zinc-400">
          <a
            href={`https://github.com/frhyme/frhyme.github.io/blob/master/src/content/posts/${filePath}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 hover:text-blue-600 dark:hover:text-blue-400 transition-colors font-medium"
          >
            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
            <span>GitHub에서 이 글의 마크다운 원본 보기 &amp; 수정 제안</span>
          </a>
          <span class="font-mono text-[11px] text-zinc-400 select-all">src/content/posts/{filePath}</span>
        </div>
      )}

      <!-- Related Posts Section -->
      {relatedPosts && relatedPosts.length > 0 && (
        <section class="mt-8 pt-8 border-t border-zinc-200/80 dark:border-zinc-800/80">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-xs uppercase tracking-wider font-bold text-zinc-400 dark:text-zinc-500 flex items-center gap-1.5 font-mono">
              <span class="text-blue-500">💡</span>
              <span>RELATED ARTICLES · 함께 읽으면 좋은 연관 포스트</span>
            </h3>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            {relatedPosts.map((item) => (
              <a
                href={item.url}
                class="group p-4 rounded-2xl border border-zinc-200/80 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/40 hover:border-blue-500/60 dark:hover:border-blue-500/60 hover:bg-white dark:hover:bg-zinc-900 hover:shadow-md transition-all flex flex-col justify-between"
              >
                <div>
                  <div class="flex items-center justify-between text-[11px] mb-2 font-mono">
                    <span class="px-2 py-0.5 rounded-md font-semibold uppercase tracking-wider bg-blue-500/10 text-blue-600 dark:text-blue-400">
                      {item.category}
                    </span>
                    <time datetime={item.date} class="text-zinc-400">
                      {item.date}
                    </time>
                  </div>
                  <h4 class="font-bold text-xs sm:text-sm text-zinc-900 dark:text-zinc-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2 leading-snug">
                    {item.title}
                  </h4>
                </div>
                <div class="mt-3 flex items-center text-[11px] font-semibold text-blue-600 dark:text-blue-400">
                  <span>읽어보기</span>
                  <span class="ml-1 group-hover:translate-x-1 transition-transform">&rarr;</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Prev / Next Post Navigation -->
      {(prevPost || nextPost) && (
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-8 pt-6 border-t border-zinc-200 dark:border-zinc-800 text-sm">
          {prevPost ? (
            <a
              href={prevPost.url}
              class="group flex flex-col p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 hover:border-blue-500 dark:hover:border-blue-500 hover:shadow-sm transition-all"
            >
              <span class="text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1 flex items-center gap-1 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                &larr; 이전 글
              </span>
              <span class="font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2">
                {prevPost.title}
              </span>
            </a>
          ) : (
            <div class="hidden sm:block" />
          )}

          {nextPost ? (
            <a
              href={nextPost.url}
              class="group flex flex-col p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 hover:border-blue-500 dark:hover:border-blue-500 hover:shadow-sm transition-all sm:text-right"
            >
              <span class="text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1 flex items-center sm:justify-end gap-1 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                다음 글 &rarr;
              </span>
              <span class="font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2">
                {nextPost.title}
              </span>
            </a>
          ) : (
            <div class="hidden sm:block" />
          )}
        </nav>
      )}

      <!-- Post Bottom Ad -->
      <AdSense slot="1181380610" className="mt-12" />
    </article>

    <!-- Sidebar (Desktop TOC & Ad) -->
    <aside class="hidden lg:block lg:col-span-4 space-y-6">
      <div class="sticky top-24 space-y-6">
        <!-- Table of Contents -->
        <TableOfContents headings={headings} />

        <!-- Sidebar AdSense Slot -->
        <div class="p-2 rounded-xl bg-zinc-50 dark:bg-zinc-900/40 border border-zinc-200/60 dark:border-zinc-800/60">
          <AdSense slot="8429315249" />
        </div>
      </div>
    </aside>
  </div>

  <!-- Back to Top Button -->
  <button
    id="back-to-top"
    aria-label="Back to top"
    class="fixed bottom-6 right-6 z-30 p-2.5 rounded-full shadow-lg border border-zinc-200 dark:border-zinc-700 bg-white/90 dark:bg-zinc-900/90 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300 cursor-pointer"
  >
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18" />
    </svg>
  </button>

  <!-- Toast Notification Container -->
  <div
    id="toast-notification"
    class="fixed bottom-8 left-1/2 -translate-x-1/2 z-50 px-4 py-2.5 rounded-2xl bg-zinc-900/95 dark:bg-zinc-100/95 text-white dark:text-zinc-900 text-xs font-semibold shadow-xl border border-zinc-700/50 dark:border-zinc-300/50 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-300 transform translate-y-3 flex items-center gap-2"
  >
    <svg class="w-4 h-4 text-emerald-400 dark:text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
    </svg>
    <span id="toast-message">글 주소가 클립보드에 복사되었습니다.</span>
  </div>

  <!-- Image Zoom / Lightbox Modal -->
  <div
    id="image-lightbox"
    class="fixed inset-0 z-50 bg-black/85 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 flex items-center justify-center p-4 sm:p-8 cursor-zoom-out"
    aria-hidden="true"
  >
    <img
      id="lightbox-img"
      src=""
      alt=""
      class="max-w-full max-h-[90vh] object-contain rounded-xl shadow-2xl transition-transform duration-300 scale-95"
    />
    <button
      id="lightbox-close"
      type="button"
      class="absolute top-4 right-4 sm:top-6 sm:right-6 p-2 rounded-full bg-zinc-800/80 hover:bg-zinc-700 text-white transition-colors cursor-pointer"
      aria-label="Close image modal"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <script is:inline>
    (() => {
      // 0. Toast Helper
      let toastTimer;
      function showToast(message) {
        const toast = document.getElementById('toast-notification');
        const toastMsg = document.getElementById('toast-message');
        if (toast && toastMsg) {
          toastMsg.textContent = message;
          toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-3');
          toast.classList.add('opacity-100', 'translate-y-0');
          clearTimeout(toastTimer);
          toastTimer = setTimeout(() => {
            toast.classList.remove('opacity-100', 'translate-y-0');
            toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-3');
          }, 2500);
        }
      }

      // 1. Code blocks: copy buttons, language tags & macOS window dots
      const pres = document.querySelectorAll('.prose pre');
      pres.forEach((pre) => {
        pre.style.position = 'relative';

        // macOS 3-color window dots
        const dots = document.createElement('div');
        dots.className = 'code-window-dots absolute top-3 left-3.5 flex items-center gap-1.5 select-none pointer-events-none';
        dots.innerHTML = `
          <span class="w-2.5 h-2.5 rounded-full bg-rose-500/70 inline-block"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-amber-500/70 inline-block"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/70 inline-block"></span>
        `;
        pre.appendChild(dots);

        // Language tag badge
        const lang = pre.dataset.language || (pre.className.match(/language-(\w+)/) ? pre.className.match(/language-(\w+)/)[1] : '');
        if (lang && lang !== 'plaintext' && lang !== 'text') {
          pre.style.paddingTop = '2.4rem';
          const langBadge = document.createElement('span');
          langBadge.className =
            'code-lang-badge absolute top-2 left-16 px-2 py-0.5 text-[10px] font-mono font-semibold rounded-md border border-zinc-700/80 bg-zinc-800/80 text-zinc-400 select-none uppercase tracking-wider pointer-events-none';
          langBadge.textContent = lang;
          pre.appendChild(langBadge);
        } else {
          pre.style.paddingTop = '2.2rem';
        }

        // Copy button
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.setAttribute('aria-label', 'Copy code');
        btn.className =
          'copy-code-btn absolute top-2 right-2 px-2 py-1 text-xs font-medium rounded-md border border-zinc-700/80 bg-zinc-800/80 text-zinc-300 hover:text-white hover:bg-zinc-700 backdrop-blur-xs transition-all flex items-center gap-1 cursor-pointer opacity-80 sm:opacity-0 sm:group-hover:opacity-100 focus:opacity-100';
        btn.innerHTML = `
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span>Copy</span>
        `;

        btn.addEventListener('click', async () => {
          const codeEl = pre.querySelector('code');
          const code = codeEl ? codeEl.innerText : pre.innerText;
          try {
            await navigator.clipboard.writeText(code);
            btn.innerHTML = `
              <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-emerald-400 font-semibold">Copied!</span>
            `;
            showToast('코드가 클립보드에 복사되었습니다.');
            setTimeout(() => {
              btn.innerHTML = `
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                <span>Copy</span>
              `;
            }, 2000);
          } catch (e) {
            console.error(e);
          }
        });

        pre.classList.add('group');
        pre.appendChild(btn);
      });

      // 2. Share / URL Copy button
      const shareBtn = document.getElementById('share-btn');
      if (shareBtn) {
        shareBtn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(window.location.href);
            showToast('글 주소가 클립보드에 복사되었습니다.');
          } catch (e) {
            showToast('주소 복사에 실패했습니다.');
          }
        });
      }

      // 3. Image Zoom / Lightbox modal & Alt Caption
      const lightbox = document.getElementById('image-lightbox');
      const lightboxImg = document.getElementById('lightbox-img');
      const lightboxClose = document.getElementById('lightbox-close');

      const proseImages = document.querySelectorAll('.prose img');
      proseImages.forEach((img) => {
        img.classList.add('cursor-zoom-in', 'hover:opacity-95', 'transition-opacity');
        img.addEventListener('click', () => {
          if (lightbox && lightboxImg) {
            lightboxImg.src = img.src;
            lightboxImg.alt = img.alt || 'Zoomed image';
            lightbox.classList.remove('opacity-0', 'pointer-events-none');
            lightbox.classList.add('opacity-100');
            lightboxImg.classList.remove('scale-95');
            lightboxImg.classList.add('scale-100');
            document.body.style.overflow = 'hidden';
          }
        });

        // Image caption from alt attribute
        const alt = (img.getAttribute('alt') || '').trim();
        const lowerAlt = alt.toLowerCase();
        if (alt && lowerAlt !== 'pic' && lowerAlt !== 'image' && lowerAlt !== 'img' && lowerAlt !== 'photo' && !img.nextElementSibling?.classList.contains('img-caption')) {
          const caption = document.createElement('figcaption');
          caption.className = 'img-caption text-center text-xs text-zinc-500 dark:text-zinc-400 mt-2 mb-4 font-mono select-none';
          caption.textContent = `▲ ${alt}`;
          img.insertAdjacentElement('afterend', caption);
        }
      });

      function closeLightbox() {
        if (lightbox && lightboxImg) {
          lightbox.classList.remove('opacity-100');
          lightbox.classList.add('opacity-0', 'pointer-events-none');
          lightboxImg.classList.remove('scale-100');
          lightboxImg.classList.add('scale-95');
          document.body.style.overflow = '';
        }
      }

      lightbox?.addEventListener('click', (e) => {
        if (e.target !== lightboxImg) {
          closeLightbox();
        }
      });
      lightboxClose?.addEventListener('click', closeLightbox);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && lightbox && !lightbox.classList.contains('opacity-0')) {
          closeLightbox();
        }
      });

      // 4. Back to top button
      const topBtn = document.getElementById('back-to-top');
      if (topBtn) {
        window.addEventListener('scroll', () => {
          if (window.scrollY > 400) {
            topBtn.classList.remove('opacity-0', 'pointer-events-none');
            topBtn.classList.add('opacity-100');
          } else {
            topBtn.classList.remove('opacity-100');
            topBtn.classList.add('opacity-0', 'pointer-events-none');
          }
        }, { passive: true });

        topBtn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }

      // 5. Reading progress bar
      const progressEl = document.getElementById('reading-progress');
      if (progressEl) {
        window.addEventListener('scroll', () => {
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          if (docHeight > 0) {
            const progress = Math.min(100, Math.max(0, (window.scrollY / docHeight) * 100));
            progressEl.style.width = `${progress}%`;
          }
        }, { passive: true });
      }

      // 6. External links target="_blank"
      const proseLinks = document.querySelectorAll('.prose a');
      proseLinks.forEach((link) => {
        if (link.hostname && link.hostname !== window.location.hostname) {
          link.setAttribute('target', '_blank');
          link.setAttribute('rel', 'noopener noreferrer');
        }
      });

      // 7. GFM Alerts (Note, Tip, Important, Warning, Caution)
      const blockquotes = document.querySelectorAll('.prose blockquote');
      blockquotes.forEach((bq) => {
        const firstP = bq.querySelector('p');
        if (!firstP) return;
        const text = firstP.innerHTML.trim();
        const match = text.match(/^\[!(NOTE|TIP|IMPORTANT|WARNING|CAUTION)\](?:\s*<br\s*\/?>|\s*\n)?\s*([\s\S]*)$/i);
        if (match) {
          const type = match[1].toUpperCase();
          const remaining = match[2];
          if (remaining.trim()) {
            firstP.innerHTML = remaining;
          } else {
            firstP.remove();
          }
          bq.classList.add('gfm-alert', `gfm-alert-${type.toLowerCase()}`);

          const header = document.createElement('div');
          header.className = 'flex items-center gap-1.5 font-bold text-xs uppercase tracking-wider mb-2 select-none';

          let icon = 'ℹ️';
          let label = 'NOTE';
          if (type === 'TIP') { icon = '💡'; label = 'TIP'; }
          else if (type === 'IMPORTANT') { icon = '📌'; label = 'IMPORTANT'; }
          else if (type === 'WARNING') { icon = '⚠️'; label = 'WARNING'; }
          else if (type === 'CAUTION') { icon = '🚨'; label = 'CAUTION'; }

          header.innerHTML = `<span>${icon}</span><span>${label}</span>`;
          bq.insertBefore(header, bq.firstChild);
        }
      });

      // 8. Heading Section Deep Links (Hover anchor & copy link)
      const proseHeadings = document.querySelectorAll('.prose h2, .prose h3, .prose h4');
      proseHeadings.forEach((h) => {
        if (!h.id) return;
        h.classList.add('group');
        const anchor = document.createElement('a');
        anchor.href = `#${h.id}`;
        anchor.className =
          'heading-anchor inline-flex items-center ml-2 text-zinc-400 dark:text-zinc-500 hover:text-blue-600 dark:hover:text-blue-400 opacity-0 group-hover:opacity-100 transition-opacity no-underline font-mono text-sm font-normal select-none cursor-pointer';
        anchor.setAttribute('aria-label', `Link to ${h.textContent}`);
        anchor.title = '섹션 링크 복사하기';
        anchor.innerHTML = `
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
          </svg>
        `;
        anchor.addEventListener('click', async (e) => {
          e.preventDefault();
          const url = new URL(window.location.href);
          url.hash = h.id;
          history.pushState(null, '', url.toString());
          h.scrollIntoView({ behavior: 'smooth' });
          try {
            await navigator.clipboard.writeText(url.toString());
            showToast('해당 섹션 링크가 복사되었습니다.');
          } catch (err) {}
        });
        h.appendChild(anchor);
      });

      // 9. Responsive Table Wrapper
      const tables = document.querySelectorAll('.prose table');
      tables.forEach((table) => {
        if (table.parentElement && !table.parentElement.classList.contains('table-wrapper')) {
          const wrapper = document.createElement('div');
          wrapper.className = 'table-wrapper overflow-x-auto my-6 border border-zinc-200 dark:border-zinc-800 rounded-xl shadow-2xs';
          table.parentNode.insertBefore(wrapper, table);
          wrapper.appendChild(table);
        }
      });
    })();
  </script>
</BaseLayout>
