---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  articleDate?: string;
}

const {
  title = 'frhyme.code',
  description = 'study, code, re-study - 개발 지식 저장소',
  image = '/assets/images/og-default.png',
  articleDate,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === 'frhyme.code' ? title : `${title} : frhyme.code`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Pretendard Variable Font (Modern technical typography) -->
    <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard-variable.dynamic.subset.min.css" />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="author" content="Seunghoon Lee" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={articleDate ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.site)} />

    <!-- Naver Search Advisor Verification -->
    <meta name="naver-site-verification" content="dc3fe6b7eafc749be73411cdfacc2855" />

    <!-- Google AdSense Manual Unit Script (Auto Ads disabled) -->
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js"
      crossorigin="anonymous"
    ></script>

    <!-- Google Analytics (GA4: G-RFTR0Z3BTP) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-RFTR0Z3BTP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-RFTR0Z3BTP');
    </script>

    <!-- KaTeX Stylesheet -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
      integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV"
      crossorigin="anonymous"
    />

    <!-- Theme Initialization (Prevent FOUC) -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>

    <!-- JSON-LD Structured Data for Search Engines -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(
        articleDate
          ? {
              '@context': 'https://schema.org',
              '@type': 'BlogPosting',
              headline: title,
              description: description,
              datePublished: articleDate,
              url: canonicalURL.toString(),
              author: {
                '@type': 'Person',
                name: 'Seunghoon Lee',
                url: 'https://github.com/frhyme',
              },
              publisher: {
                '@type': 'Organization',
                name: 'frhyme.code',
                url: 'https://frhyme.github.io',
              },
              mainEntityOfPage: {
                '@type': 'WebPage',
                '@id': canonicalURL.toString(),
              },
            }
          : {
              '@context': 'https://schema.org',
              '@type': 'WebSite',
              name: 'frhyme.code',
              headline: 'frhyme.code',
              description: description,
              url: 'https://frhyme.github.io',
              author: {
                '@type': 'Person',
                name: 'Seunghoon Lee',
                url: 'https://github.com/frhyme',
              },
            }
      )}
    />
  </head>
  <body class="flex flex-col min-h-screen relative overflow-x-hidden selection:bg-blue-500/20 selection:text-blue-900 dark:selection:text-blue-200">
    <!-- Ambient top glow for Vercel/Linear technical aesthetic -->
    <div class="fixed inset-0 -z-10 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[700px] sm:w-[900px] h-[360px] bg-gradient-to-b from-blue-500/10 via-indigo-500/5 to-transparent dark:from-blue-600/15 dark:via-purple-600/5 blur-3xl opacity-70"></div>
    </div>
    <Header />
    <main class="flex-1 max-w-5xl mx-auto px-4 sm:px-6 w-full py-8 sm:py-10">
      <slot />
    </main>
    <Footer />
  </body>
</html>
